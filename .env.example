# Paths and logging
WORD_MADNESS_PROJECT_ROOT=
WORD_MADNESS_LOG_LEVEL=INFO
WORD_MADNESS_DEBUG=false
WORD_MADNESS_SAVE_SCREENSHOTS=false
WORD_MADNESS_SAVE_DEBUG_IMAGES=false

# Android Debug Bridge
WORD_MADNESS_ADB_COMMAND=adb
WORD_MADNESS_ADB_TIMEOUT_SECONDS=15
WORD_MADNESS_DEVICE_SERIAL=

# State classification
WORD_MADNESS_STATE_MINIMUM_CONFIDENCE=0.65
WORD_MADNESS_STATE_CONFLICT_MARGIN=0.10
WORD_MADNESS_STATE_STABLE_FRAMES=2

# Swipe planning
WORD_MADNESS_SWIPE_INTERPOLATION_POINTS=4
WORD_MADNESS_SWIPE_SMOOTHING_STRENGTH=0.5
WORD_MADNESS_SWIPE_DURATION_PER_LETTER_MS=120
WORD_MADNESS_SWIPE_MAXIMUM_STEP_FRACTION=0.25

# Advertisement policy
WORD_MADNESS_AD_INITIAL_WAIT_SECONDS=3.0
WORD_MADNESS_AD_RETRY_DELAY_SECONDS=1.0
WORD_MADNESS_AD_TIMEOUT_SECONDS=30.0
WORD_MADNESS_AD_MAX_ATTEMPTS=4
WORD_MADNESS_AD_MINIMUM_CONFIDENCE=0.75
WORD_MADNESS_AD_ALLOW_BACK_FALLBACK=true
WORD_MADNESS_AD_BACK_KEY_CODE=4

# Decision and runtime policy
WORD_MADNESS_DECISION_MAX_RETRIES=3
WORD_MADNESS_DECISION_RETRY_DELAY_SECONDS=1.0
WORD_MADNESS_WORD_MAX_ATTEMPTS=2
WORD_MADNESS_RUN_INTERVAL_SECONDS=1.0

# Observability
WORD_MADNESS_METRICS_ENABLED=true
WORD_MADNESS_DIAGNOSTICS_ENABLED=false
WORD_MADNESS_DIAGNOSTIC_ARTIFACTS_ENABLED=false
WORD_MADNESS_ARTIFACT_MAXIMUM_FILES=100
WORD_MADNESS_ARTIFACT_MAXIMUM_BYTES=100000000
WORD_MADNESS_HEALTH_STALE_AFTER_SECONDS=30.0
